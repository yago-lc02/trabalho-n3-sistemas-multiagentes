# Configuração do Sistema Multiagentes de Estudos
# Modo de Provedor LLM: 'gemini', 'openai', 'ollama' ou 'demo'
LLM_PROVIDER=demo

# Chaves para modo Nuvem (preencha a que for utilizar no evento se tiver internet)
OPENAI_API_KEY=
# Gemini: uma chave ou várias separadas por vírgula (chave1, chave2, chave3).
# Quando a cota de uma acaba, o sistema passa para a próxima automaticamente.
# Cada chave deve ser de um projeto diferente do Google, pois a cota é por projeto.
GEMINI_API_KEY=

# Modelos recomendados Nuvem:
# OpenAI: gpt-4o-mini ou gpt-4o
# Gemini: gemini-2.5-flash ou gemini-2.5-pro
OPENAI_MODEL_NAME=gpt-4o-mini
GEMINI_MODEL_NAME=gemini-2.5-flash

# Configuração Modo Offline / Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
